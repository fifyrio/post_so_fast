# ---- TikTok app (developers.tiktok.com) ----
TIKTOK_CLIENT_KEY=your-client-key
TIKTOK_CLIENT_SECRET=your-client-secret
# Must match a redirect URI registered in the TikTok app. localhost is allowed in sandbox.
TIKTOK_REDIRECT_URI=http://localhost:4477/callback
# Scope for inbox/draft upload. video.publish is only needed for Direct Post.
TIKTOK_SCOPES=video.upload

# How the video reaches TikTok:
#   PULL_FROM_URL  -> TikTok fetches the R2 public URL (requires the R2 domain to be
#                     verified under URL properties in the TikTok dev portal)
#   FILE_UPLOAD    -> we PUT the bytes straight to TikTok (always works, no domain check)
TIKTOK_SOURCE=FILE_UPLOAD

# ---- Cloudflare R2 (S3 API) ----
# From Cloudflare dashboard -> R2 -> Manage R2 API Tokens -> Create (S3 credentials)
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=sova-api-bucket
# Public dev domain (or your custom domain) used to build the returned URL
R2_PUBLIC_ENDPOINT=https://pub-f7bc7d24ac944d8f8077090974993667.r2.dev

# Where uploaded video tokens are stored (defaults to ./tokens.json)
# TOKENS_FILE=./tokens.json
